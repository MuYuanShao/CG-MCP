# Frontend (dev only)
VITE_API_BASE_URL=http://localhost:8080/api
# Used by Vite dev proxy (server-side only, never exposed to browser)
VITE_API_KEY=replace_with_local_api_key
CORS_ORIGIN=http://localhost:5173

# Spring Boot API
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_FLYWAY_ENABLED=true
# WARNING: allowPublicKeyRetrieval=true & useSSL=false are for local dev ONLY.
# In production, use SSL and disable public key retrieval.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/spd-mcp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=replace_with_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_database_password
APP_API_KEY=replace_with_local_api_key
APP_ADMIN_USERNAME=root
APP_ADMIN_PASSWORD=replace_with_admin_password
# REQUIRED: use a high-entropy random string, never reuse APP_API_KEY
APP_AUTH_TOKEN_SECRET=replace_with_high_entropy_auth_secret
APP_AUTH_TOKEN_TTL_SECONDS=1800
APP_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
APP_AUTH_REFRESH_COOKIE_NAME=spd_refresh_token
# Set to true in production (requires HTTPS)
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# MySQL
MYSQL_DATABASE=spd-mcp 
MYSQL_USER=replace_with_database_user 
MYSQL_PASSWORD=replace_with_database_password 
MYSQL_ROOT_PASSWORD=replace_with_root_password 
MYSQL_PORT=3306

# SPD-PR integration: set a strong per-instance shared secret in the BACKEND environment.
# The configuration page stores only this variable name. Leave blank until configured.
SPD_PR_MAIN_TOKEN=
